{
  "name": "bookforge",
  "private": true,
  "version": "2.0.0",
  "description": "BookForge \u2014 universal manuscript file converter, reader and editor.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server-build/server.cjs",
    "start": "cross-env NODE_ENV=production node server-build/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');for(const p of ['dist','server-build','server.js','server.cjs'])fs.rmSync(p,{recursive:true,force:true});\"",
    "lint": "tsc --noEmit",
    "test": "npm run build:server && cross-env BOOKFORGE_NO_LISTEN=1 node --test tests/*.test.mjs",
    "test:browser": "npm run build:server && node tests/run-browser.mjs",
    "test:all": "npm test && npm run test:browser"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@google/genai": "^2.4.0",
    "adm-zip": "^0.5.17",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}

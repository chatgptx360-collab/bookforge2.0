# Google Gemini — powers speech synthesis and the reader's lookup.
# Speech is Gemini-only; OpenRouter has no equivalent audio modality.
GEMINI_API_KEY=

# Optional: comma-separated rotation list used when a model hits its quota.
# GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-2.5-flash-lite,gemini-2.0-flash

# Optional: speech model used by /api/tts/speak.
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Optional fallback provider for the text endpoints when GEMINI_API_KEY is absent.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional rate limits, per IP per hour.
# AI_RATE_LIMIT=40
# TTS_RATE_LIMIT=4000
# CONVERT_RATE_LIMIT=120

# Port for the local dev/production server (default 3000).
# PORT=3000
